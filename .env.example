# Gemini participant: a Gemini API key (free tier works; get one at aistudio.google.com)
GEMINI_API_KEY=AIza...
# Optional: which Gemini model to ask first (falls back to older Flash models if unavailable)
# GEMINI_MODEL=gemini-3.8-flash

# Only needed for the API backend (Claude and Codex normally run on your subscriptions via their CLIs)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Max seconds to wait for each model call (default 2400 = 40 min)
# CLI_TIMEOUT_SECONDS=2400
